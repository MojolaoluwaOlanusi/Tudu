{
  "name": "Tudu - Your Friendly Todo App",
  "short_name": "Tudu",
  "description": "A friendly todo app with a brush-stroke feel.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#fafafa",
  "theme_color": "#22c55e",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
