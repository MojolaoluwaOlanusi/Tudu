  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-github2": "^0.1.12",
    "express-session": "^1.17.3",
    "socket.io": "^4.7.2",
    "openai": "^4.20.1",
    "chrono-node": "^2.6.1",
    "date-fns": "^2.30.0",
    "zod": "^3.22.4",
