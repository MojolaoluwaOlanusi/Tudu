{
  "name": "tudu-backend",
  "version": "1.0.0",
  "description": "Backend API for Tudu todo application",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node -r ts-node/register migrations/init.ts"
  },
  "keywords": ["todo", "express", "typescript"],
