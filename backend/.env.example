# Database
DATABASE_URL=postgresql://user:password@host:5432/tudu

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# OAuth - GitHub
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback

# AI task breakdown - pick one provider.
# All three below are free and do NOT require a credit card.
#   gemini  -> https://aistudio.google.com/apikey   (default)
#   groq    -> https://console.groq.com/keys
#   ollama  -> local, no key at all: `ollama serve` then `ollama pull llama3.2`
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: override the model for the selected provider
# AI_MODEL=gemini-2.5-flash
# Only used when AI_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434

API_TOKEN_HASH_PEPPER=

RESEND_API_KEY=re_paste_your_key_here
REMINDER_FROM_EMAIL=Tudu <onboarding@resend.dev>
REMINDER_CRON_SECRET=<paste a 64-char hex string>
APP_URL=http://localhost:5173

PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PLAN_PRO_MONTHLY=PLN_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PLAN_PRO_YEARLY=PLN_xxxxxxxxxxxxxxxxxxxx

# Session
SESSION_SECRET=your-session-secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Server
PORT=5000
NODE_ENV=development
